# Demo values only. Copy to apps/api/.env to run the API outside Docker; Docker Compose sets its own.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_dev?schema=public
CORS_ORIGIN=http://localhost:5173

# Sign-in (Phase 2). Demo values only.
# One-click demo sign-in for the seeded demo accounts; the API refuses this in production.
AUTH_DEMO_LOGIN=true
# Password of the seeded FAKE demo users (local demo value, not a secret).
DEMO_USER_PASSWORD=local-demo-only-2026
# Session cookie over HTTPS only (default: on in production).
# AUTH_COOKIE_SECURE=false

# Web, read at BUILD time (Vite dev server, `vite build`, Docker Compose). true = fake demo data and a
# one-click demo sign-in. Defaults: on for `pnpm dev` and the Compose stack, off for every other build
# (including `docker build` of docker/web.Dockerfile). Never set true for a real deployment.
VITE_DEMO_MODE=true
