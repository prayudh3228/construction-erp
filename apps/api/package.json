{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "pnpm db:generate && nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@erp/shared": "workspace:*",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.2",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.7",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2"
  }
}
