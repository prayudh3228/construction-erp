# Copy to apps/api/.env for running the API outside Docker. Demo values only.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_dev?schema=public
CORS_ORIGIN=http://localhost:5173

# Sign-in (Phase 2). Demo values only.
# One-click demo sign-in for the seeded demo accounts; the API refuses this in production.
AUTH_DEMO_LOGIN=true
# Password of the seeded FAKE demo users (local demo value, not a secret).
DEMO_USER_PASSWORD=local-demo-only-2026
# Encrypts authenticator secrets. DEMO VALUE: the API refuses it in production; generate your
# own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=MIBS9Ln91jpbLoWadi1S/81K/i8T+NFmcT3wZmRaQg4=
# Authenticator secret of the seeded FAKE demo.admin account (demo two-factor sign-in, E2E tests).
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
# Session cookie over HTTPS only (default: on in production).
# AUTH_COOKIE_SECURE=false
